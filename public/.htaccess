<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On
    RewriteBase /360-seo-monthly-reports/

    # Pass Authorization header through
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Block access to sensitive files
    RewriteRule ^(\.env|composer\.(json|lock)|artisan|package\.json)$ - [F,L]

    # Serve real files from public/ (absolute path = internal rewrite)
    RewriteCond %{DOCUMENT_ROOT}/360-seo-monthly-reports/public/$1 -f
    RewriteRule ^(.+)$ %{DOCUMENT_ROOT}/360-seo-monthly-reports/public/$1 [L]

    # Everything else → Laravel front controller (absolute path = internal rewrite)
    RewriteRule ^ %{DOCUMENT_ROOT}/360-seo-monthly-reports/public/index.php [L]
</IfModule>